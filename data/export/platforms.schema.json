{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-platform-benchmark/platforms.schema.json",
  "title": "Agent platform benchmark export",
  "description": "Schema 1.0.0 of data/export/platforms.json, generated by `scripts/benchmark.py scores`. Every array holds flat records with a string `id` that is stable across builds as long as the platform, criterion and dimension IDs in data/*.csv do not change. Foreign keys: *_id fields point to the `id` of a record in the named array (platform_id -> platforms, criterion_id -> criteria, dimension_id -> dimensions). Scores are floats rounded to 4 decimals; the exact values are fractions computed by the script. A breaking change bumps the major version of schema_version.",
  "type": "object",
  "required": ["schema_version", "id", "title", "snapshot", "licence", "disclaimer", "llm_assisted", "documentation",
               "value_table", "dimensions", "criteria", "platforms", "evidence", "dimension_scores", "index_scores",
               "scenarios", "summary"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
    "id": {"type": "string", "description": "Dataset id, e.g. agent-platform-benchmark-2026-11."},
    "title": {"type": "string"},
    "snapshot": {
      "type": "object",
      "required": ["accessed_from", "accessed_to"],
      "additionalProperties": false,
      "properties": {
        "accessed_from": {"type": "string", "format": "date"},
        "accessed_to": {"type": "string", "format": "date"}
      }
    },
    "licence": {
      "type": "object",
      "required": ["data", "code"],
      "additionalProperties": false,
      "properties": {"data": {"const": "CC-BY-4.0"}, "code": {"const": "MIT"}}
    },
    "disclaimer": {"type": "string", "description": "Must be shown wherever scores are shown."},
    "llm_assisted": {"type": "boolean", "description": "True: evidence collection and re-verification were carried out by LLM agents under the author's supervision."},
    "documentation": {
      "type": "object",
      "required": ["method", "scores", "schema"],
      "additionalProperties": false,
      "properties": {"method": {"type": "string"}, "scores": {"type": "string"}, "schema": {"type": "string"}}
    },
    "value_table": {
      "type": "array",
      "description": "Level-to-value table (METHOD.md). One record per evidence status.",
      "items": {
        "type": "object",
        "required": ["id", "status", "lower", "upper"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "status": {"$ref": "#/$defs/status"},
          "lower": {"$ref": "#/$defs/unit"},
          "upper": {"$ref": "#/$defs/unit"}
        }
      }
    },
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "order", "label", "question", "default_weight", "criterion_ids"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "description": "eval_qa, prod_gov or voice_eu."},
          "order": {"type": "integer"},
          "label": {"type": "string"},
          "question": {"type": "string"},
          "default_weight": {"$ref": "#/$defs/unit"},
          "criterion_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "short", "group", "dimension_id", "has_value", "index_weight"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "short": {"type": "string"},
          "group": {"type": "string", "description": "Display group used in docs/results.md (not the scoring dimension)."},
          "dimension_id": {"type": "string"},
          "has_value": {"type": "boolean"},
          "index_weight": {"$ref": "#/$defs/unit", "description": "Implicit weight of the criterion in the default index (dimension weight / number of criteria in the dimension)."}
        }
      }
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "vendor", "products_covered", "docs_root", "trust_url", "pricing_url",
                     "public_docs", "search_coverage", "inclusion_signal", "inclusion_signal_url"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string", "description": "Name in use on the access date."},
          "vendor": {"type": "string"},
          "products_covered": {"type": "string"},
          "docs_root": {"type": ["string", "null"]},
          "trust_url": {"type": ["string", "null"]},
          "pricing_url": {"type": ["string", "null"]},
          "public_docs": {"enum": ["yes", "partial", "no"]},
          "search_coverage": {"enum": ["full", "partial", "none"], "description": "partial/none: not_found cells rest on a narrower search (METHOD.md, change 2)."},
          "inclusion_signal": {"type": "string", "description": "Inclusion rule C met: C1, C2, C3, separated by ';'."},
          "inclusion_signal_url": {"type": "string"}
        }
      }
    },
    "evidence": {
      "type": "array",
      "description": "One record per (platform, criterion) cell: 17 x 24 = 408 in this snapshot.",
      "items": {
        "type": "object",
        "required": ["id", "platform_id", "criterion_id", "dimension_id", "status", "value", "source_type", "url",
                     "accessed", "note", "score_lower", "score_upper"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+:[a-z0-9_]+$", "description": "<platform_id>:<criterion_id>"},
          "platform_id": {"type": "string"},
          "criterion_id": {"type": "string"},
          "dimension_id": {"type": "string"},
          "status": {"$ref": "#/$defs/status"},
          "value": {"type": ["string", "null"], "description": "Short recorded value (channels, billing unit...). Not scored."},
          "source_type": {"enum": ["docs", "trust", "pricing", "legal", "marketing", "blog", "press", null]},
          "url": {"type": ["string", "null"], "description": "Null exactly when status is not_found or not_applicable."},
          "accessed": {"type": "string", "format": "date"},
          "note": {"type": "string", "description": "Short paraphrase of the source, or the searches tried."},
          "score_lower": {"$ref": "#/$defs/unit"},
          "score_upper": {"$ref": "#/$defs/unit"}
        }
      }
    },
    "dimension_scores": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "platform_id", "dimension_id", "lower", "upper", "coverage", "n_criteria", "n_documented",
                     "n_vendor_states", "n_not_found", "n_not_applicable"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "description": "<platform_id>:<dimension_id>"},
          "platform_id": {"type": "string"},
          "dimension_id": {"type": "string"},
          "lower": {"$ref": "#/$defs/unit"},
          "upper": {"$ref": "#/$defs/unit"},
          "coverage": {"$ref": "#/$defs/unit", "description": "Share of cells with evidence; upper - lower = 1 - coverage."},
          "n_criteria": {"type": "integer"},
          "n_documented": {"type": "integer"},
          "n_vendor_states": {"type": "integer"},
          "n_not_found": {"type": "integer"},
          "n_not_applicable": {"type": "integer"}
        }
      }
    },
    "index_scores": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "platform_id", "lower", "upper", "coverage", "cells_with_evidence", "cells_total", "band",
                     "possible_rank_best", "possible_rank_worst", "rank_lower_default", "rank_lower_min",
                     "rank_lower_max", "rank_upper_default", "rank_upper_min", "rank_upper_max", "band_min", "band_max"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "description": "<platform_id>:index"},
          "platform_id": {"type": "string"},
          "lower": {"$ref": "#/$defs/unit"},
          "upper": {"$ref": "#/$defs/unit"},
          "coverage": {"$ref": "#/$defs/unit", "description": "Weighted mean of dimension coverages (default weights)."},
          "cells_with_evidence": {"type": "integer"},
          "cells_total": {"type": "integer"},
          "band": {"type": "integer", "minimum": 1, "description": "Interval-dominance band on the default index. Not a quality grade."},
          "possible_rank_best": {"type": "integer", "minimum": 1},
          "possible_rank_worst": {"type": "integer", "minimum": 1},
          "rank_lower_default": {"type": "integer", "minimum": 1},
          "rank_lower_min": {"type": "integer", "minimum": 1},
          "rank_lower_max": {"type": "integer", "minimum": 1},
          "rank_upper_default": {"type": "integer", "minimum": 1},
          "rank_upper_min": {"type": "integer", "minimum": 1},
          "rank_upper_max": {"type": "integer", "minimum": 1},
          "band_min": {"type": "integer", "minimum": 1},
          "band_max": {"type": "integer", "minimum": 1}
        }
      }
    },
    "scenarios": {
      "type": "array",
      "description": "Sensitivity scenarios; the first has kind 'default'.",
      "items": {
        "type": "object",
        "required": ["id", "kind", "label", "weights", "vendor_states_value", "dropped_criterion_id",
                     "max_rank_shift_lower", "max_rank_shift_upper"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "kind": {"enum": ["default", "weights", "value_table", "leave_one_out"]},
          "label": {"type": "string"},
          "weights": {"type": "object", "additionalProperties": {"$ref": "#/$defs/unit"}},
          "vendor_states_value": {"$ref": "#/$defs/unit"},
          "dropped_criterion_id": {"type": ["string", "null"]},
          "max_rank_shift_lower": {"type": "integer", "minimum": 0},
          "max_rank_shift_upper": {"type": "integer", "minimum": 0}
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["platform_count", "criterion_count", "cell_count", "overlapping_pairs", "platform_pairs",
                   "rule_a_met", "rule_b_met", "ranking_published"],
      "additionalProperties": false,
      "properties": {
        "platform_count": {"type": "integer"},
        "criterion_count": {"type": "integer"},
        "cell_count": {"type": "integer"},
        "overlapping_pairs": {"type": "integer"},
        "platform_pairs": {"type": "integer"},
        "rule_a_met": {"type": "boolean"},
        "rule_b_met": {"type": "boolean"},
        "ranking_published": {"type": "boolean", "description": "False: do not display a ranked list; show ranges and bands."}
      }
    }
  },
  "$defs": {
    "status": {"enum": ["documented", "vendor_states", "not_found", "not_applicable"]},
    "unit": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
